# =================================================================
# Modèle de configuration — copier en .env puis adapter.
#   PowerShell :  Copy-Item .env.example .env
#   Bash       :  cp .env.example .env
# Toutes les valeurs ci-dessous sont FICTIVES. Le fichier .env n'est jamais versionné.
# =================================================================

# --- Application ---
APP_ENV=local            # local | test | ci
LOG_LEVEL=INFO

# --- PostgreSQL (conteneur docker compose) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cip
POSTGRES_USER=cip_app
POSTGRES_PASSWORD=change-me-local-only

# Compte en lecture seule utilisé par l'assistant Text-to-SQL (sprint 6)
ASSISTANT_DB_USER=cip_assistant
ASSISTANT_DB_PASSWORD=change-me-readonly

# --- LLM (sprint 6) ---
# mock : réponses déterministes, aucune clé requise (tests, CI, démo hors-ligne)
# groq : API Groq (offre gratuite). Créer une clé sur console.groq.com et la coller ci-dessous dans .env uniquement.
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=

# --- MLflow (sprint 4) ---
MLFLOW_TRACKING_URI=http://localhost:5000
